%% Flowchart for ping_google.sh — WGU D796 Part E1/E2
flowchart TD
    A([Start ping_google.sh]) --> B[Set TARGET = google.com<br/>COUNT = 3, TIMEOUT = 5s]
    B --> C[Run: ping -c $COUNT -W $TIMEOUT $TARGET]
    C --> D{Exit code == 0?}
    D -- Yes --> E[Print &quot;Network is up.&quot;]
    E --> F([Exit 0])
    D -- No --> G[Print &quot;Network is down...&quot;]
    G --> H([Exit 1])
